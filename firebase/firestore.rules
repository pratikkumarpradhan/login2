rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminRecord() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isRoleAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == "admin";
    }

    function isAdmin() {
      return isAdminRecord() || isRoleAdmin();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userCreateKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "firstName",
        "lastName",
        "displayName",
        "email",
        "phone",
        "address",
        "city",
        "state",
        "postalCode",
        "country",
        "role",
        "accountStatus",
        "emailVerified",
        "deviceToken",
        "deviceTokens",
        "lastDevice",
        "createdAt",
        "updatedAt"
      ]);
    }

    function userCreateSafe() {
      return userCreateKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "user"
        && request.resource.data.accountStatus == "active"
        && request.resource.data.emailVerified == request.auth.token.email_verified;
    }

    function ownerProfileKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "firstName",
        "lastName",
        "displayName",
        "phone",
        "address",
        "city",
        "state",
        "postalCode",
        "country",
        "emailVerified",
        "deviceToken",
        "deviceTokens",
        "lastDevice",
        "updatedAt"
      ]);
    }

    function ownerProfileSafe() {
      return ownerProfileKeys()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.email == resource.data.email
        && request.resource.data.emailVerified == request.auth.token.email_verified;
    }
    /* Public contact form — anyone can submit; only admins can read */
    match /contact/{contactId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          "name",
          "email",
          "subject",
          "message",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow create, update, delete: if isAdmin();
    }

    match /Users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isOwner(userId) && userCreateSafe();

      allow update: if isAdmin() || (isOwner(userId) && ownerProfileSafe());

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /components/{componentId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /kits/{kitId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["shippingAddress", "phone", "updatedAt"])
        );

      allow delete: if isAdmin();
    }

    /* Admin-only computer billing / invoices */
    match /bills/{billId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /billingMeta/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /site/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
